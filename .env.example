# Copy to .env.local (local) or set in Vercel → Settings → Environment Variables.

# Claude (server only)
ANTHROPIC_API_KEY=

# Supabase: Project Settings → Data API (URL) and API Keys.
# The URL is the bare project URL, without /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: safe in the browser; row-level security decides access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Bypasses row-level security; never expose it.
SUPABASE_SECRET_KEY=

# Rate limits (Upstash Redis). Vercel's Upstash integration adds these automatically.
# Without them (local development) limits are counted in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Bank import
# BANK_PROVIDER=mock
# Required before using a live bank provider: encrypts stored access tokens.
# BANK_TOKEN_KEY=
